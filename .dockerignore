# Docker skips everything listed here when packaging the build.
# What survives = only what the COPY lines need: pyproject.toml, uv.lock, src/

# macOS junk (appears in root, src/, .git/)
**/.DS_Store

# Dev virtual env — would leak torch into the "torch-free" image
.venv/

# Version control and CI config
.git/
.gitignore
.github/

# Dev tooling caches (regenerated automatically)
.pytest_cache/
.ruff_cache/
**/__pycache__/

# Dev container definition (builds your coding env, not the server)
.devcontainer/

# Python version pin — the base image already fixes 3.12
.python-version

# Tests — the server never runs its own tests
tests/

# The model is regenerated by stage 1, so the local copy isn't needed
models/

# Not read during build (--no-install-project means hatchling never reads it)
README.md